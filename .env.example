# Server-side only. Set these in Vercel for Production and for Preview (the
# two are separate), and never commit real values. None is ever sent to the browser.

# The model behind NoBroke AI (/api/chat).
GROQ_API_KEY=your_key_here

# Postgres, for accounts and saved plans (POSTGRES_URL also works).
DATABASE_URL=postgres://user:password@host/db

# Signs sign-in sessions. A long random value, for example: openssl rand -base64 32
AUTH_SECRET=a_long_random_value

# New accounts need this code. Leave it unset and sign-up is closed.
# Use 12 or more random letters and digits, for example: openssl rand -hex 8
INVITE_CODE=a_long_random_code
